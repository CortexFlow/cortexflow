{
  "name": "cortexflow",
  "homepage": "https://www.cortexflow.org/",
  "version": "0.1.0",
  "description": "",
  "main": "./app/page.jsx",
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "aos": "^2.3.4",
    "concurrently": "^9.2.0",
    "next": "^15.4.4",
    "postcss-cli": "^11.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "slick-carousel": "^1.8.1",
    "typed.js": "^2.1.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run tailwind-dev\" \"next dev\"",
    "prod": "npm run tailwind-prod && next build && npx serve@latest out",
    "tailwind-dev": "tailwindcss -i ./styles/tw-global.css -o ./styles/style.css --watch",
    "tailwind-prod": "tailwindcss -i ./styles/tw-global.css -o ./styles/style.css --minify"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11"
  }
}
